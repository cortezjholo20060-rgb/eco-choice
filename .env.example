# ---- Public site settings ----
# Full public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Abuse protection ----
# Any long random string. Used to hash visitor IPs before storing them (raw IPs are never stored).
# Generate one with: openssl rand -hex 32
RATE_LIMIT_SALT=replace-with-a-long-random-string

# ---- Optional: academic project details shown on the About page ----
# Leave blank to hide the block. Members are separated by semicolons.
NEXT_PUBLIC_PROJECT_TITLE=
NEXT_PUBLIC_PROJECT_COURSE=
NEXT_PUBLIC_PROJECT_INSTITUTION=
NEXT_PUBLIC_PROJECT_MEMBERS=
